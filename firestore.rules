rules_version = '2';

// Jacky's Editing Portfolio — Firestore security rules.
// Public can read the portfolio. Only the owner email can write.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner() {
      return request.auth != null
        && request.auth.token.email == 'anaflousoussama666@gmail.com';
    }

    // Portfolio entries: everyone reads, owner writes.
    match /portfolio/{projectId} {
      allow read: if true;
      allow create, update, delete: if isOwner();
    }

    // Optional site settings document (hero text, availability flag, etc.)
    match /settings/{docId} {
      allow read: if true;
      allow write: if isOwner();
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
